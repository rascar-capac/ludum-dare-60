<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <Style src="MainMenu.uss" />
    <ui:VisualElement name="menu" class="menu">
        <ui:VisualElement name="main-page" class="menu-page">
            <ui:Button name="begin-button" text="Begin" class="menu-entry menu-button" />
            <ui:Button name="settings-button" text="Settings" class="menu-entry menu-button" />
            <ui:Button name="quit-button" text="Quit" class="menu-entry menu-button" />
        </ui:VisualElement>
        <ui:VisualElement name="settings-page" class="menu-page menu-page--hidden">
            <ui:Slider name="sound-slider" label="Sound" low-value="0" high-value="1" page-size="0.1" class="menu-entry menu-slider" />
            <ui:Slider name="music-slider" label="Music" low-value="0" high-value="1" page-size="0.1" class="menu-entry menu-slider" />
            <ui:Button name="back-button" text="Back" class="menu-entry menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
