.hud {
    flex-grow: 1;
}

/* Owned items, bottom right corner. row-reverse: the first slot is the rightmost one, so slots fill from right to left. */
.spear-slots {
    position: absolute;
    right: 32px;
    bottom: 32px;
    flex-direction: row-reverse;
}

/* Spear sprites are horizontal: each icon is rotated to stand upright in its slot. */
.spear-slot {
    width: 17px;
    height: 115px;
    margin-left: 4px;
    align-items: center;
    justify-content: center;
}

.spear-slot__icon {
    position: absolute;
    width: 115px;
    height: 17px;
    rotate: -90deg;
    background-image: url("project://database/Assets/Art/Sprites/spear_slot.png");
}

.spear-slot--full .spear-slot__icon {
    width: 105px;
    height: 9px;
    background-image: url("project://database/Assets/Art/Sprites/spear.png?fileID=1337014109&guid=92e5b09db719c1b47a0af71ce8a1bbfb&type=3#spear_0");
}
